# Step 12: systemd unit. Edit User, WorkingDirectory, paths and the API key, then:
#   sudo cp deploy/vllm.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now vllm
[Unit]
Description=vLLM OpenAI-compatible server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/LLM_FineTuning_Serving
Environment=PATH=/home/ubuntu/venvs/serve/bin:/usr/local/bin:/usr/bin:/bin
Environment=HF_HOME=/home/ubuntu/.cache/huggingface
Environment=MODE=model
Environment=MODEL_PATH=models/merged-qwen7b-w4a16
Environment=SERVED_NAME=my-model
# The API key is read from ~/.vllm_api_key of the User above (chmod 600).
# serve_vllm.sh listens on 127.0.0.1; set HOST=0.0.0.0 only behind a firewall or reverse proxy.
ExecStart=/bin/bash scripts/serve_vllm.sh
Restart=on-failure
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
